# Required
MONGODB_URI=mongodb://127.0.0.1:27017/careerconnect
JWT_SECRET=replace-with-a-long-random-secret-before-running

# Optional: default API port is 5000
PORT=5000

# Frontend origins allowed by credentialed CORS
CLIENT_URL=http://localhost:5173
# CLIENT_URLS=https://your-frontend-domain.example,https://your-preview-domain.example

# Required only for profile image, resume and company logo uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
